# ============================================================================
# StudyPath Environment Variables
# ============================================================================

# Local Server Configuration
PORT=3000
NODE_ENV=production
SESSION_EXPIRY_HOURS=72
SESSION_COOKIE_NAME=studypath_session

# ============================================================================
# Hosted Database Configuration (Vercel Postgres, Neon, Supabase, Render, etc.)
# ============================================================================
# Set POSTGRES_URL or DATABASE_URL in Vercel Project Settings > Environment Variables.
# NEVER put this secret connection string into client-side code (app.js, index.html).
# When this variable is absent, StudyPath automatically falls back to local data/studypath.db.
POSTGRES_URL=postgres://username:password@hostname:5432/databasename?sslmode=require
DATABASE_URL=postgres://username:password@hostname:5432/databasename?sslmode=require
